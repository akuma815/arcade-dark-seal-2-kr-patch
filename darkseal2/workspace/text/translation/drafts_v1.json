{
 "_note": "2편 메시지 블록 초벌(2026-10-04). 행 = 레코드 행과 1:1, 틀 행은 \"\". 각 행은 layout.rows[i].span 폭 이하. 공백 = 빈 셀. 뒤쪽 빈 행은 생략 가능.",
 "M:000": {"ko_rows": [" 갈리아력 355년 7월, 유로 대륙", " 동쪽 기슭 대국 “에트루리아”에서", " 후세에 이름 높은 “봉인 전쟁”이", " 일어난다‥‥."]},
 "M:005": {"ko_rows": [" 그때, 네 “빛의 기사”의 활약으로", " 전쟁은 승리로 막을 내렸다", " ‥‥‥‥."]},
 "M:009": {"ko_rows": [" 그로부터 두 해가 흘렀다‥‥."]},
 "M:023": {"ko_rows": ["", "방심했군‥‥‥.", "저런 것들이 나서다니", "‥‥‥."]},
 "M:039": {"ko_rows": ["", "실패했군요‥‥.", "역시 처음부터 제가 갔어야", "했습니다. 두고 보십시오! 저는", "당신처럼 어리석은 짓은 하지 않습니다."]},
 "M:055": {"ko_rows": ["", "가겠습니다‼ 그리고 666명 제물의", "피로 “용문”을 완성시켜,", "이번에야말로 루시퍼 님의", "부활을 이루겠습니다‼"]},
 "M:071": {"ko_rows": ["", "분부대로‥‥‥."]},
 "M:087": {"ko_rows": ["", "후후후후‥‥.", "두고 보아라, 어리석은 인간들아.", "루시퍼 님! 조금만 더 참아", "주십시오! 반드시 이 제논이", "봉인을 풀어 보이겠나이다‼"], "notes": "ゼノン→제논"},
 "M:104": {"ko_rows": ["", "「끔찍한 꼴이네!」", "", "「어둠의 군세에 습격당했다기에", "서둘러 와 봤는데‥‥.」"]},
 "M:120": {"ko_rows": ["", "「전쟁도 이 정도는 아닌데‥.」", "", "「그토록 아름답던 마을이‥‥", "끔찍해‥‥‼」"]},
 "M:136": {"ko_rows": ["", "「와 주었구나‥‥ 호크!」", "", "「제이드‼ 무사했군!」"], "notes": "ホーク→호크, ジェイド→제이드"},
 "M:152": {"ko_rows": ["", "「내가 왔을 땐 이미 이 꼴이었네.」", "", "「무고한 이를 죽이다니 용서 못해‼」"]},
 "M:168": {"ko_rows": ["", "「아직 숨이 붙은 놈이 있었나⁉」", "", "「이놈이 범인이군⁉ 때려죽여 주마‼」"]},
 "M:184": {"ko_rows": ["", "「놈들, 뭘 꾸미는 거야!」", "", "「뭘 꾸미든 하나도 남김없이", "박살 내 주마‼」"]},
 "M:200": {"ko_rows": ["", "「이 던전이 독수의 근원인가⁉」", "", "「젠장! 때려 부숴 주마‼」"]},
 "M:216": {"ko_rows": ["", "「놈들의 부유요새다‥‥‼」"]},
 "M:232": {"ko_rows": ["", "「젠장! 어떻게 가야 하는 거지", "‥‥‼」"]},
 "M:248": {"ko_rows": ["", "「방법이 없진 않아. 근처에", "아크발의 능묘가 있어. 그 안의", "성스러운 마법진은 어디든", "원하는 곳으로 보내 준단다.」"], "notes": "アクバル→아크발"},
 "M:264": {"ko_rows": ["", "「좋아! 그럼 거기로 가자‼」"]},
 "M:280": {"ko_rows": ["", "「여기야‼」"], "notes": "span 6셀 제한으로 축약(こっちよ‼)"},
 "M:296": {"ko_rows": ["", "「다들 이젠 어쩔래?」"]},
 "M:312": {"ko_rows": ["", "「동쪽에 “칼마트”란 항구가 있어,", "난 거기로 갈 생각인데‥‥.」"], "notes": "カルマート→칼마트"},
 "M:328": {"ko_rows": ["", "「고향으로 가겠네‥.」"]},
 "M:344": {"ko_rows": ["", "「난 “바들”에서 기다리는 사람이", "있어.」", "", "「이거지?」"], "notes": "バードル→바들(검토). これじゃろう？ 문맥 확인 필요"},
 "M:360": {"ko_rows": ["", "「난 우파 사원에 가. 찾는", "사람이 있거든‥‥.」"], "notes": "ウーファ→우파"},
 "M:376": {"ko_rows": ["", "「흠. 그럼 난 호크와 갈래,", "재미있을 것 같거든.」"]},
 "M:392": {"ko_rows": ["", "「인연이 있으면 또 보자!」", "", "「아아‥‥ 그래.」"]}
}
